{
  "name": "listenos",
  "version": "0.1.21",
  "description": "AI-powered desktop voice control and productivity assistant",
  "private": true,
  "main": "electron/main.cjs",
  "author": "ListenOS",
  "license": "PROPRIETARY",
  "scripts": {
    "dev": "node scripts/rspack-dev.mjs",
    "build": "node scripts/rspack-build.mjs",
    "start": "node scripts/rspack-dev.mjs",
    "lint": "eslint",
    "version:sync": "node scripts/sync-version.mjs",
    "release:prepare": "node scripts/bump-version.mjs",
    "backend:build": "cargo build --manifest-path backend/Cargo.toml --release",
    "desktop:dev": "node scripts/electron-dev.mjs",
    "desktop:build": "npm run version:sync && npm run build && npm run backend:build && electron-builder --publish never",
    "desktop:build:windows": "npm run version:sync && npm run build && npm run backend:build && electron-builder --win nsis --publish never",
    "desktop:build:mac": "npm run version:sync && npm run build && npm run backend:build && electron-builder --mac dmg zip --publish never",
    "desktop:build:linux": "npm run version:sync && npm run build && npm run backend:build && electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^3.1.0",
    "@hugeicons/react": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/themes": "^3.2.1",
    "@solar-icons/react": "^1.1.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.6.2",
    "framer-motion": "^12.23.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@rspack/core": "^2.1.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "eslint-plugin-jsx-a11y": "^6",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "electron",
    "electron-builder",
    "sharp",
    "unrs-resolver"
  ],
  "build": {
    "appId": "com.listenos.app",
    "productName": "ListenOS",
    "asar": true,
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "backend/icons/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/target/release",
        "to": "backend",
        "filter": [
          "listenos-backend",
          "listenos-backend.exe"
        ]
      }
    ],
    "protocols": [
      {
        "name": "ListenOS",
        "schemes": [
          "listenos"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://pub-d6533f84d6a6405ab5f83d5a61d118ac.r2.dev"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "backend/icons/icon.ico",
      "artifactName": "ListenOS-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "backend/icons/icon.icns",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "10.15",
      "entitlements": "backend/entitlements.plist",
      "entitlementsInherit": "backend/entitlements.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ListenOS needs microphone access for voice commands and dictation.",
        "NSAppleEventsUsageDescription": "ListenOS needs automation access to control other applications when you request it."
      },
      "artifactName": "ListenOS-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "backend/icons/icon.png",
      "category": "Utility",
      "artifactName": "ListenOS-${version}.${ext}"
    }
  }
}
